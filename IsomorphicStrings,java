class isIsomorphicStrings {
    public boolean isIsomorphic(String s, String t) {
        int[] mapS = new int[256];
        int[] mapt = new int[256];

        for(int i = 0; i < s.length(); i++){
            int a = s.charAt(i);
            int b = t.charAt(i);

            if(mapS[a] != mapt[b]){
                return false;
            }

            mapS[a] = i + 1;
            mapt[b] = i + 1;
        }
        return true;
    }
}